{
    "name": "drupalwxt/site-wxt",
    "description": "Project template for Drupal 10 sites built with the WxT distribution.",
    "type": "project",
    "license": "GPL-2.0+",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "composer/installers": "^2.1",
        "cweagans/composer-patches": "^1.7",
        "drupal/core-composer-scaffold": "11.1.*",
        "drupalwxt/wxt": "6.1.x-dev"
    },
    "require-dev": {
        "drupal/core-dev": "11.1.*",
        "drupal/drupal-extension": "5.0.0-alpha1",
        "drush/drush": "^13.3.3",
        "oomphinc/composer-installers-extender": "^1.1 || ^2",
        "squizlabs/php_codesniffer": "3.*",
        "phpspec/prophecy-phpunit": "^2",
        "vlucas/phpdotenv": "^5.1",
        "webflo/drupal-finder": "^1.2"
    },
    "replace": {
        "drupal/embed": "self.version",
        "drupal/url_embed": "self.version",
        "drupal/entity_embed": "self.version",
        "drupal/fontawesome": "self.version",
        "drupal/layout_builder_st": "self.version",
        "drupal/toc_api": "self.version"
    },
    "config": {
        "discard-changes": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "composer",
            "url": "https://drupalwxt.github.io/composer-extdeps/"
        },
        {
            "type": "package",
            "package": {
                "name": "drupaloverride/embed",
                "version": "dev-master",
                "type": "drupal-module",
                "source": {
                    "url": "https://git.drupalcode.org/issue/embed-3430097.git",
                    "type": "git",
                    "reference": "3430097-automated-drupal-11"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "drupaloverride/url_embed",
                "version": "dev-master",
                "type": "drupal-module",
                "source": {
                    "url": "https://git.drupalcode.org/issue/url_embed-3438709.git",
                    "type": "git",
                    "reference": "composer-workaround-d11"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "drupaloverride/entity_embed",
                "version": "dev-master",
                "type": "drupal-module",
                "source": {
                    "url": "https://git.drupalcode.org/issue/entity_embed-3430164.git",
                    "type": "git",
                    "reference": "3430164-d11-readiness"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "drupaloverride/fontawesome",
                "version": "dev-master",
                "type": "drupal-module",
                "source": {
                    "url": "https://git.drupalcode.org/issue/fontawesome-3465765.git",
                    "type": "git",
                    "reference": "3465765-drupal-11-compatibility"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "drupaloverride/layout_builder_st",
                "version": "dev-master",
                "type": "drupal-module",
                "source": {
                    "url": "https://git.drupalcode.org/issue/layout_builder_st-3431600.git",
                    "type": "git",
                    "reference": "3431600-automated-drupal-11"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "drupaloverride/toc_api",
                "version": "dev-master",
                "type": "drupal-module",
                "source": {
                    "url": "https://git.drupalcode.org/issue/toc_api-3455312.git",
                    "type": "git",
                    "reference": "3455312-drupal11-fixes"
                }
            }
        }
    ],
    "scripts": {
        "post-create-project-cmd": "rm -r -f behat.yml",
        "quick-start": [
            "composer install"
        ]
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/libraries/{$name}": [
                "type:drupal-console-library",
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/profiles/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": { },
        "patches-ignore": { }
    },
    "autoload": {
        "classmap": [
            "scripts/ScriptHandler.php"
        ]
    }
}
